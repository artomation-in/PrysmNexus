---
import SeoLayout from "../../layouts/SeoLayout.astro";
import { brand, breadcrumbSchema, caseStudySchema, caseStudies } from "../../data/seo";

export const getStaticPaths = () => caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));

const { study } = Astro.props;
const origin = (Astro.site ?? new URL(brand.domain)).origin;

const schemas = [
  breadcrumbSchema(origin, [
    { name: "Home", path: "/" },
    { name: "Case Studies", path: "/case-studies/" },
    { name: study.name, path: `/case-studies/${study.slug}/` },
  ]),
  caseStudySchema(origin, study),
];

const keywords = [
  `${study.name} case study`,
  `${study.sector} marketing India`,
  ...study.services,
  "PrysmNexus client results",
];
---

<SeoLayout
  title={`${study.name} Marketing Case Study | PrysmNexus`}
  description={`${study.summary} Review the user-provided campaign evidence and connected services.`}
  keywords={keywords}
  eyebrow={`${study.sector} case study`}
  heading={study.title}
  lead={study.summary}
  schemas={schemas}
>
  <div class="seoMain">
    <aside class="answerBlock">
      <span>Result Context (AEO Direct Answer)</span>
      <p>
        {study.metrics.length > 0
          ? "This case study documents selected figures from proposal screenshots supplied by PrysmNexus. Results describe the captured platform period only and do not guarantee the same outcome for another business."
          : "This engagement is currently active. Published campaign metrics and performance reporting will be added here once a complete reporting period is verified."}
      </p>
    </aside>

    {study.metrics.length > 0 && (
      <section class="seoSection">
        <div class="seoSectionHead">
          <h2>Selected evidence.</h2>
          <p>Each figure remains attached to its source context rather than being blended into an unsupported overall claim.</p>
        </div>
        <div class="metricGrid">
          {study.metrics.map((metric) => (
            <article class="metricCard">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
              <small>{metric.note}</small>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="seoSection">
      <div class="seoSectionHead">
        <h2>Connected services.</h2>
        <p>The work combined the following capabilities around one brand and customer journey.</p>
      </div>
      <ul class="seoList">
        {study.services.map((service) => (
          <li>{service}</li>
        ))}
      </ul>
    </section>

    <section class="seoSection">
      <div class="seoSectionHead">
        <h2>How to interpret the result.</h2>
        <p>Platform figures such as impressions, views, audience, and engagement describe distribution and response. Commercial evaluation should also consider enquiries, visits, bookings, sales quality, costs, and the reporting period available to the business.</p>
      </div>
      <div class="seoRelated" style="margin-top:24px">
        <a href="/case-studies/">
          <small>Explore More Proof</small>
          <strong>All Case Studies ↗</strong>
        </a>
        <a href="/contact/#consultation-form">
          <small>Plan Your Project</small>
          <strong>Request Free Consultation ↗</strong>
        </a>
      </div>
    </section>
  </div>
</SeoLayout>
