---
import SeoLayout from "../../layouts/SeoLayout.astro";
import { brand, breadcrumbSchema, caseStudies } from "../../data/seo";

const origin = (Astro.site ?? new URL(brand.domain)).origin;
const schemas = [
  breadcrumbSchema(origin, [
    { name: "Home", path: "/" },
    { name: "Case Studies", path: "/case-studies/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "PrysmNexus Client Case Studies",
    itemListElement: caseStudies.map((study, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${origin}/case-studies/${study.slug}/`,
      name: study.name,
    })),
  },
];

const keywords = [
  "marketing case studies India",
  "PrysmNexus client results",
  "fashion academy branding case study",
  "hospitality marketing proof",
  "retail growth results India",
];
---

<SeoLayout
  title="Marketing Case Studies | PrysmNexus India"
  description="Named PrysmNexus case studies covering hospitality content, social media, brand strategy, and digital discovery in India."
  keywords={keywords}
  eyebrow="First-party evidence"
  heading="Selected work, named clients, and clearly labelled results."
  lead="These case studies use figures supplied in the PrysmNexus proposal. Metrics are presented with their platform context and are not treated as universal performance promises."
  schemas={schemas}
>
  <div class="seoMain">
    <aside class="answerBlock">
      <span>Evidence Policy (AEO Summary)</span>
      <p>PrysmNexus publishes only client and performance information approved for use. Every metric on these pages is labelled with source context and should be evaluated within its captured platform and reporting period.</p>
    </aside>
    <div class="seoIndexGrid">
      {caseStudies.map((study) => (
        <a class="seoIndexCard" href={`/case-studies/${study.slug}/`}>
          <small>{study.sector}</small>
          <div>
            <h2>{study.name}</h2>
            <p>{study.title}</p>
          </div>
          <strong>Read case study ↗</strong>
        </a>
      ))}
    </div>
  </div>
</SeoLayout>
